// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  guest
  admin
}

model UserSession {
  id         String   @id @default(cuid())
  name       String?
  role       Role     @default(guest)
  ip         String?
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  queueItems QueueItem[] @relation("AddedBy")
  adminGrant AdminGrant?

  @@index([ip])
  @@index([lastSeenAt])
}

model QueueItem {
  id           String   @id @default(cuid())
  provider     String
  trackId      String
  title        String
  artist       String?
  thumbnailUrl String?
  durationSec  Int?
  audioUrl     String?
  addedAt      DateTime @default(now())
  position     Int

  addedBySessionId String?
  addedBy          UserSession? @relation("AddedBy", fields: [addedBySessionId], references: [id], onDelete: SetNull)

  nowPlaying NowPlaying?

  @@index([position])
  @@index([provider, trackId])
  @@index([addedAt])
}

model NowPlaying {
  id         Int      @id
  queueItemId String?  @unique
  provider   String?
  trackId    String?
  startedAt  DateTime?
  isPaused   Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  queueItem QueueItem? @relation(fields: [queueItemId], references: [id], onDelete: SetNull)

  @@index([queueItemId])
}

model SongMetadata {
  provider     String
  trackId      String
  title        String
  artist       String?
  durationSec  Int?
  thumbnailUrl String?
  audioUrl     String?
  playCount    Int      @default(0)
  lastPlayedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  playHistory PlayHistory[]

  @@index([playCount])
  @@index([lastPlayedAt])
  @@id([provider, trackId])
}

model PlayHistory {
  id            String   @id @default(cuid())
  provider      String
  trackId       String
  playedAt      DateTime @default(now())
  playedCountDelta Int   @default(1)

  song SongMetadata @relation(fields: [provider, trackId], references: [provider, trackId], onDelete: Cascade)

  @@index([playedAt])
  @@index([provider, trackId, playedAt])
}

model AdminGrant {
  sessionId String   @id
  grantedAt DateTime @default(now())
  revokedAt DateTime?

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Ban {
  id       String   @id @default(cuid())
  ip       String?
  sessionId String?
  bannedAt DateTime @default(now())
  reason   String?

  @@index([ip])
  @@index([sessionId])
}
