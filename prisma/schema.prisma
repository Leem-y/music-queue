// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  guest
  admin
}

model UserSession {
  id         String   @id @default(cuid())
  name       String?
  role       Role     @default(guest)
  ip         String?
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  queueItems QueueItem[] @relation("AddedBy")
  adminGrant AdminGrant?

  @@index([ip])
  @@index([lastSeenAt])
}

model QueueItem {
  id           String   @id @default(cuid())
  youtubeId    String
  title        String
  artist       String?
  thumbnailUrl String?
  durationSec  Int?
  addedAt      DateTime @default(now())
  position     Int

  addedBySessionId String?
  addedBy          UserSession? @relation("AddedBy", fields: [addedBySessionId], references: [id], onDelete: SetNull)

  nowPlaying NowPlaying?

  @@index([position])
  @@index([youtubeId])
  @@index([addedAt])
}

model NowPlaying {
  id         Int      @id
  queueItemId String?  @unique
  youtubeId  String?
  startedAt  DateTime?
  isPaused   Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  queueItem QueueItem? @relation(fields: [queueItemId], references: [id], onDelete: SetNull)

  @@index([queueItemId])
}

model SongMetadata {
  youtubeId    String   @id
  title        String
  artist       String?
  durationSec  Int?
  thumbnailUrl String?
  playCount    Int      @default(0)
  lastPlayedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  playHistory PlayHistory[]

  @@index([playCount])
  @@index([lastPlayedAt])
}

model PlayHistory {
  id            String   @id @default(cuid())
  youtubeId     String
  playedAt      DateTime @default(now())
  playedCountDelta Int   @default(1)

  song SongMetadata @relation(fields: [youtubeId], references: [youtubeId], onDelete: Cascade)

  @@index([playedAt])
  @@index([youtubeId, playedAt])
}

model AdminGrant {
  sessionId String   @id
  grantedAt DateTime @default(now())
  revokedAt DateTime?

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Ban {
  id       String   @id @default(cuid())
  ip       String?
  sessionId String?
  bannedAt DateTime @default(now())
  reason   String?

  @@index([ip])
  @@index([sessionId])
}
